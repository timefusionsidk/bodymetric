# Canonical production URL (no trailing slash). Used in SEO tags and the sitemap.
VITE_SITE_URL=https://bodymetric-silk.vercel.app

# Optional display advertising. Leave both blank to keep ads disabled;
# BodyMetric works fully without them. Only fill these in with real,
# approved publisher/slot IDs from your ad provider.
VITE_AD_PUBLISHER_ID=
VITE_AD_SLOT_ID=
